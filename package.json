{
  "name": "zk-kyc",
  "version": "0.1.0",
  "private": true,
  "description": "ZK-KYC Wallet & Verifier SDK — zero-knowledge credential wallet with selective disclosure",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "dev:wallet": "pnpm --filter @zk-kyc/wallet dev",
    "dev:issuer": "pnpm --filter @zk-kyc/mock-issuer dev",
    "dev:verifier": "pnpm --filter @zk-kyc/mock-verifier-app dev",
    "contracts:test": "pnpm --filter @zk-kyc/contracts test",
    "contracts:deploy": "pnpm --filter @zk-kyc/contracts deploy:amoy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
